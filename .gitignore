# Rust build artifacts
/target/
**/*.rs.bk

# Runtime data: the mind's own log, vault and journals are not source.
/data/

# Isolated worktrees — the implementation branch lives here.
/.worktrees/

# Superpowers scratch: ledgers, briefs, review packages. Not source.
/.superpowers/

# Python bytecode caches written by the lexicon tools
__pycache__/
*.pyc

# Editor / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Local secrets — never commit an API key
.env
.env.*
!.env.example
